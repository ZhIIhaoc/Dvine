<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dvinedao.mapper.DevineMomentImageMapper">

    <!-- Result Map for DevineMomentImage -->
    <resultMap id="DevineMomentImageResultMap" type="com.dvinedao.domain.DevineMomentImage">
        <id property="imageId" column="imageId"/>
        <result property="momentId" column="momentId"/>
        <result property="imageUrl" column="imageUrl"/>
        <result property="isPrimary" column="isPrimary"/>
        <result property="createTime" column="createTime"/>
    </resultMap>

    <!-- Insert moment image -->
    <insert id="insertImage" parameterType="com.dvinedao.domain.DevineMomentImage" 
            useGeneratedKeys="true" keyProperty="imageId">
        INSERT INTO devine_moment_images (momentId, imageUrl, isPrimary)
        VALUES (#{momentId}, #{imageUrl}, #{isPrimary})
    </insert>

    <!-- Find images by moment ID -->
    <select id="findImagesByMomentId" resultMap="DevineMomentImageResultMap">
        SELECT imageId, momentId, imageUrl, isPrimary, createTime
        FROM devine_moment_images
        WHERE momentId = #{momentId}
        ORDER BY isPrimary DESC, createTime ASC
    </select>

    <!-- Find image URLs by moment ID -->
    <select id="findImageUrlsByMomentId" resultType="string">
        SELECT imageUrl
        FROM devine_moment_images
        WHERE momentId = #{momentId}
        ORDER BY isPrimary DESC, createTime ASC
    </select>

    <!-- Delete images by moment ID -->
    <delete id="deleteImagesByMomentId">
        DELETE FROM devine_moment_images 
        WHERE momentId = #{momentId}
    </delete>

    <!-- Delete specific image -->
    <delete id="deleteImage">
        DELETE FROM devine_moment_images 
        WHERE imageId = #{imageId}
    </delete>

    <!-- Update primary image status -->
    <update id="updatePrimaryImage">
        UPDATE devine_moment_images 
        SET isPrimary = CASE WHEN imageId = #{imageId} THEN true ELSE false END
        WHERE momentId = #{momentId}
    </update>

</mapper>