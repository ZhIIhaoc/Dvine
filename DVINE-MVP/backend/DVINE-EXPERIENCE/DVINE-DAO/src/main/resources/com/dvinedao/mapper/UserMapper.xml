<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dvinedao.mapper.UserMapper">

    <insert id="insertUser" parameterType="com.dvinedao.domain.User"
            useGeneratedKeys="true" keyProperty="userId" keyColumn="userId">
        INSERT INTO users (
        password,
        email,
        phone,
        postcode,
        nickName,
        firstName,
        lastName,
        avatar,
        permission
        )
        VALUES (
        #{password},
        #{email},
        #{phone},
        #{postcode},
        #{nickName},
        #{firstName},
        #{lastName},
        #{avatar},
        #{permission}
        )
    </insert>

    <update id="updateUser" parameterType="com.dvinedao.domain.User">
        UPDATE users
        <set>
            <if test="email != null and email != ''">email = #{email},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="postcode != null and postcode != ''">postcode = #{postcode},</if>
            <if test="firstName != null and firstName != ''">firstName = #{firstName},</if>
            <if test="lastName != null and lastName != ''">lastName = #{lastName},</if>
            <if test="nickName != null and nickName != ''">nickName = #{nickName},</if>
            <if test="avatar != null and avatar != ''">avatar = #{avatar},</if>
        </set>
        WHERE userId = #{userId}
    </update>


    <select id="findUserById" resultType="com.dvinedao.domain.UserQueryParam">
        SELECT
            *
        FROM users WHERE userId = #{userId}
    </select>

    <select id="selectUserByIdAndPwd" resultType="com.dvinedao.domain.User">
        SELECT
            *
        FROM users WHERE userId = #{userId} AND password = #{password}
    </select>

    <select id="selectUserByEmail" resultType="com.dvinedao.domain.User">
        SELECT
            *
        FROM users WHERE email = #{email}
    </select>
    <select id="findPermissionById" resultType="java.lang.Integer">
        SELECT
            permission
        FROM users WHERE userId = #{userId}
    </select>
    <select id="getUserList" resultType="com.dvinedao.domain.User">
        SELECT
            userId,
            email,
            phone,
            postcode,
            nickName,
            firstName,
            lastName,
            avatar,
            permission
        FROM users

    </select>
</mapper>