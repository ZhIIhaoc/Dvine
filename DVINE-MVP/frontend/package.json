    "@mui/material": "^7.1.2",
    "@mui/x-date-pickers": "^8.9.0",
    "@stripe/stripe-js": "^7.5.0",
    "@uiw/react-md-editor": "^4.0.8",
    "axios": "^1.10.0",
    "date-fns": "^4.1.0",
    "lodash": "^4.17.21",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "remark-breaks": "^4.0.0",
