{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:dev": "cypress run --config baseUrl=http://localhost:5173",


    "test:e2e:auth": "cypress run --spec \"cypress/e2e/authentication.cy.js\"",
    "test:e2e:booking": "cypress run --spec \"cypress/e2e/booking-flow.cy.js\"",
    "test:e2e:social": "cypress run --spec \"cypress/e2e/social-features.cy.js\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
